
{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "create-block/campus-event-card",
    "version": "0.1.0",
    "title": "Campus Event Card",
    "category": "widgets",
    "icon": "calendar-alt",
    "description": "A customizable campus event card with optional images and registration.",
    "example": {},
    "attributes": {
        "eventTitle": {
            "type": "string",
            "default": ""
        },
        "eventDate": {
            "type": "string",
            "default": ""
        },
        "eventLocation": {
            "type": "string",
            "default": ""
        },
        "eventDescription": {
            "type": "string",
            "default": ""
        },
        "registrationUrl": {
            "type": "string",
            "default": ""
        },
        "registrationText": {
            "type": "string",
            "default": "Register Now"
        },
        "eventImageId": {
            "type": "number",
            "default": 0
        },
        "eventImageUrl": {
            "type": "string",
            "default": ""
        },
        "eventImageAlt": {
            "type": "string",
            "default": ""
        },	
		"eventCategory": {
			"type": "string",
			"default": ""
		}
    },
    "supports": {
        "html": false
    },
    "textdomain": "campus-event-card",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "viewScript": "file:./view.js"
}
